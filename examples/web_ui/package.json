{
	"name": "agentscope-web-ui",
	"version": "1.0.0",
	"private": true,
	"main": "electron-dist/main.js",
	"scripts": {
		"dev:frontend": "pnpm --filter frontend dev",
		"dev:backend": "pnpm --filter backend dev",
		"dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
		"build:frontend": "pnpm --filter frontend build",
		"build:backend": "pnpm --filter backend build",
		"build": "pnpm build:frontend && pnpm build:backend",
		"electron:compile": "npx tsc -p electron/tsconfig.json",
		"electron:dev": "pnpm electron:compile && concurrently \"pnpm dev:frontend\" \"npx wait-on http://localhost:5173 && npx electron .\"",
		"electron:build": "pnpm build:frontend && pnpm electron:compile && npx electron-builder --config electron-builder.yml",
		"format": "prettier --write . && pnpm --filter frontend lint:fix",
		"format:check": "prettier --check . && pnpm --filter frontend lint",
		"prepare": "husky"
	},
	"lint-staged": {
		"frontend/**/*.{ts,tsx}": [
			"prettier --write",
			"cd frontend && pnpm eslint --fix"
		],
		"backend/**/*.{ts,js}": [
			"prettier --write"
		],
		"*.{json,css,md,html,yaml,yml}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"concurrently": "^8.2.2",
		"electron": "^43.1.1",
		"electron-builder": "^26.15.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"typescript": "^7.0.2",
		"wait-on": "^9.0.10"
	}
}
